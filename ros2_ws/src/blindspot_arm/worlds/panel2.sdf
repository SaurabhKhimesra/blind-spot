<?xml version="1.0"?>
<sdf version="1.10">
  <world name="blindspot">
    <physics name="fast" type="ignored">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.95 0.95 0.95 1</diffuse>
      <direction>-0.4 0.1 -0.9</direction>
    </light>
    <light type="point" name="fill">
      <pose>0.3 0 0.9 0 0 0</pose>
      <diffuse>0.7 0.7 0.7 1</diffuse>
      <attenuation><range>6</range><linear>0.25</linear></attenuation>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="c"><geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry></collision>
        <visual name="v">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material><ambient>0.3 0.32 0.36 1</ambient><diffuse>0.35 0.37 0.42 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- The panel the arm inserts into. Six fiducial dots around the socket.
         The panel TILTS on a revolute joint: partway through the approach it
         swings toward edge-on, the projected polygon flattens, and the
         geometry degenerates while all six dots stay perfectly visible and
         perfectly detected. That is the regime nothing but the area guard
         notices. -->
    <model name="panel_left">
      <pose>0.636 -0.250 0.359 0 0 -1.5708</pose>
      <link name="post">
        <inertial><mass>50</mass><inertia><ixx>1</ixx><iyy>1</iyy><izz>1</izz></inertia></inertial>
        <visual name="v">
          <pose>0.16 0 -0.21 0 0 0</pose>
          <geometry><box><size>0.03 0.03 0.42</size></box></geometry>
          <material><ambient>0.25 0.26 0.3 1</ambient><diffuse>0.3 0.31 0.35 1</diffuse></material>
        </visual>
      </link>
      <link name="plate">
        <pose>0 0 0 0 0 0</pose>
        <inertial><mass>1.5</mass><inertia><ixx>0.01</ixx><iyy>0.01</iyy><izz>0.01</izz></inertia></inertial>
        <collision name="c"><geometry><box><size>0.006 0.17 0.17</size></box></geometry></collision>
        <visual name="face">
          <geometry><box><size>0.006 0.17 0.17</size></box></geometry>
          <material><ambient>0.93 0.93 0.95 1</ambient><diffuse>0.98 0.98 1 1</diffuse></material>
        </visual>
        <visual name="socket">
          <pose>-0.0032 0 0 0 1.5708 0</pose>
          <geometry><cylinder><radius>0.014</radius><length>0.001</length></cylinder></geometry>
          <material><ambient>0.15 0.35 0.6 1</ambient><diffuse>0.2 0.45 0.75 1</diffuse></material>
        </visual>
        <visual name="dot0">
          <pose>-0.0032 0.05000 0.00000 0 1.5708 0</pose>
          <geometry><cylinder><radius>0.008</radius><length>0.001</length></cylinder></geometry>
          <material><ambient>0.02 0.02 0.02 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material>
        </visual>
        <visual name="dot1">
          <pose>-0.0032 0.02500 0.04330 0 1.5708 0</pose>
          <geometry><cylinder><radius>0.008</radius><length>0.001</length></cylinder></geometry>
          <material><ambient>0.02 0.02 0.02 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material>
        </visual>
        <visual name="dot2">
          <pose>-0.0032 -0.02500 0.04330 0 1.5708 0</pose>
          <geometry><cylinder><radius>0.008</radius><length>0.001</length></cylinder></geometry>
          <material><ambient>0.02 0.02 0.02 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material>
        </visual>
        <visual name="dot3">
          <pose>-0.0032 -0.05000 0.00000 0 1.5708 0</pose>
          <geometry><cylinder><radius>0.008</radius><length>0.001</length></cylinder></geometry>
          <material><ambient>0.02 0.02 0.02 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material>
        </visual>
        <visual name="dot4">
          <pose>-0.0032 -0.02500 -0.04330 0 1.5708 0</pose>
          <geometry><cylinder><radius>0.008</radius><length>0.001</length></cylinder></geometry>
          <material><ambient>0.02 0.02 0.02 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material>
        </visual>
        <visual name="dot5">
          <pose>-0.0032 0.02500 -0.04330 0 1.5708 0</pose>
          <geometry><cylinder><radius>0.008</radius><length>0.001</length></cylinder></geometry>
          <material><ambient>0.02 0.02 0.02 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material>
        </visual>
      </link>
      <!-- the model cannot be <static> because the tilt joint must move,
           so the base has to be anchored explicitly. Without this the whole
           panel falls under gravity: measured Z 0.359 -> 0.085, which put it
           out of the camera's view entirely. -->
      <joint name="anchor" type="fixed">
        <parent>world</parent>
        <child>post</child>
      </joint>
      <joint name="tilt" type="revolute">
        <parent>post</parent>
        <child>plate</child>
        <axis>
          <xyz>0 0 1</xyz>
          <limit><lower>-1.6</lower><upper>1.6</upper><effort>200</effort><velocity>3</velocity></limit>
          <dynamics><damping>2.0</damping></dynamics>
        </axis>
      </joint>
      <plugin filename="gz-sim-joint-position-controller-system"
              name="gz::sim::systems::JointPositionController">
        <joint_name>tilt</joint_name>
        <topic>/panel_tilt_left</topic>
        <p_gain>40</p_gain><i_gain>0.5</i_gain><d_gain>6</d_gain>
      </plugin>
    </model>

    <model name="panel_right">
      <pose>-0.264 -0.250 0.359 0 0 -1.5708</pose>
      <link name="post">
        <inertial><mass>50</mass><inertia><ixx>1</ixx><iyy>1</iyy><izz>1</izz></inertia></inertial>
        <visual name="v">
          <pose>0.16 0 -0.21 0 0 0</pose>
          <geometry><box><size>0.03 0.03 0.42</size></box></geometry>
          <material><ambient>0.25 0.26 0.3 1</ambient><diffuse>0.3 0.31 0.35 1</diffuse></material>
        </visual>
      </link>
      <link name="plate">
        <pose>0 0 0 0 0 0</pose>
        <inertial><mass>1.5</mass><inertia><ixx>0.01</ixx><iyy>0.01</iyy><izz>0.01</izz></inertia></inertial>
        <collision name="c"><geometry><box><size>0.006 0.17 0.17</size></box></geometry></collision>
        <visual name="face">
          <geometry><box><size>0.006 0.17 0.17</size></box></geometry>
          <material><ambient>0.93 0.93 0.95 1</ambient><diffuse>0.98 0.98 1 1</diffuse></material>
        </visual>
        <visual name="socket">
          <pose>-0.0032 0 0 0 1.5708 0</pose>
          <geometry><cylinder><radius>0.014</radius><length>0.001</length></cylinder></geometry>
          <material><ambient>0.15 0.35 0.6 1</ambient><diffuse>0.2 0.45 0.75 1</diffuse></material>
        </visual>
        <visual name="dot0">
          <pose>-0.0032 0.05000 0.00000 0 1.5708 0</pose>
          <geometry><cylinder><radius>0.008</radius><length>0.001</length></cylinder></geometry>
          <material><ambient>0.02 0.02 0.02 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material>
        </visual>
        <visual name="dot1">
          <pose>-0.0032 0.02500 0.04330 0 1.5708 0</pose>
          <geometry><cylinder><radius>0.008</radius><length>0.001</length></cylinder></geometry>
          <material><ambient>0.02 0.02 0.02 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material>
        </visual>
        <visual name="dot2">
          <pose>-0.0032 -0.02500 0.04330 0 1.5708 0</pose>
          <geometry><cylinder><radius>0.008</radius><length>0.001</length></cylinder></geometry>
          <material><ambient>0.02 0.02 0.02 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material>
        </visual>
        <visual name="dot3">
          <pose>-0.0032 -0.05000 0.00000 0 1.5708 0</pose>
          <geometry><cylinder><radius>0.008</radius><length>0.001</length></cylinder></geometry>
          <material><ambient>0.02 0.02 0.02 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material>
        </visual>
        <visual name="dot4">
          <pose>-0.0032 -0.02500 -0.04330 0 1.5708 0</pose>
          <geometry><cylinder><radius>0.008</radius><length>0.001</length></cylinder></geometry>
          <material><ambient>0.02 0.02 0.02 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material>
        </visual>
        <visual name="dot5">
          <pose>-0.0032 0.02500 -0.04330 0 1.5708 0</pose>
          <geometry><cylinder><radius>0.008</radius><length>0.001</length></cylinder></geometry>
          <material><ambient>0.02 0.02 0.02 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material>
        </visual>
      </link>
      <!-- the model cannot be <static> because the tilt joint must move,
           so the base has to be anchored explicitly. Without this the whole
           panel falls under gravity: measured Z 0.359 -> 0.085, which put it
           out of the camera's view entirely. -->
      <joint name="anchor" type="fixed">
        <parent>world</parent>
        <child>post</child>
      </joint>
      <joint name="tilt" type="revolute">
        <parent>post</parent>
        <child>plate</child>
        <axis>
          <xyz>0 0 1</xyz>
          <limit><lower>-1.6</lower><upper>1.6</upper><effort>200</effort><velocity>3</velocity></limit>
          <dynamics><damping>2.0</damping></dynamics>
        </axis>
      </joint>
      <plugin filename="gz-sim-joint-position-controller-system"
              name="gz::sim::systems::JointPositionController">
        <joint_name>tilt</joint_name>
        <topic>/panel_tilt_right</topic>
        <p_gain>40</p_gain><i_gain>0.5</i_gain><d_gain>6</d_gain>
      </plugin>
    </model>
  </world>
</sdf>
