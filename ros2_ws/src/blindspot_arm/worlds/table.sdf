<?xml version="1.0"?>
<sdf version="1.10">
  <world name="blindspot">
    <physics name="1ms" type="ignored">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <direction>-0.3 0.2 -0.9</direction>
    </light>
    <light type="point" name="fill">
      <pose>0.6 0 1.2 0 0 0</pose>
      <diffuse>0.6 0.6 0.6 1</diffuse>
      <attenuation><range>8</range><linear>0.2</linear></attenuation>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="c"><geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry></collision>
        <visual name="v">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material><ambient>0.35 0.36 0.4 1</ambient><diffuse>0.4 0.42 0.46 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- the workpiece the arm servos to: a plate carrying six fiducial dots.
         Dots are separate dark cylinders on a white plate, which the detector
         finds by blob centroid. Deliberately NOT a single ArUco texture: the
         guard needs individually identifiable points. -->
    <model name="target_plate">
      <static>true</static>
      <pose>0.55 0.0 0.30 0 0 0</pose>
      <link name="plate">
        <visual name="v">
          <geometry><box><size>0.004 0.16 0.16</size></box></geometry>
          <material><ambient>0.95 0.95 0.95 1</ambient><diffuse>1 1 1 1</diffuse></material>
        </visual>
        <collision name="c"><geometry><box><size>0.004 0.16 0.16</size></box></geometry></collision>
      </link>
    </model>
  </world>
</sdf>
