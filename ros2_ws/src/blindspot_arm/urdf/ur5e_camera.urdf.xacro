<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="ur5e_camera">

  <!-- UR5e, plus an eye-in-hand camera on the wrist, plus gz_ros2_control.
       The stock ur_simulation_gz launch is not used: it spawns
       ur_controllers/ScaledJointTrajectoryController, whose loader is not
       found against ros2_control 6.9.0 on this distro. We declare only the
       controllers we need, which are present. -->

  <xacro:arg name="ur_type" default="ur5e"/>
  <xacro:arg name="name" default="ur"/>

  <link name="world"/>

  <xacro:include filename="$(find ur_description)/urdf/ur_macro.xacro"/>
  <xacro:ur_robot
      name="$(arg name)"
      tf_prefix=""
      parent="world"
      joint_limits_parameters_file="$(find ur_description)/config/$(arg ur_type)/joint_limits.yaml"
      kinematics_parameters_file="$(find ur_description)/config/$(arg ur_type)/default_kinematics.yaml"
      physical_parameters_file="$(find ur_description)/config/$(arg ur_type)/physical_parameters.yaml"
      visual_parameters_file="$(find ur_description)/config/$(arg ur_type)/visual_parameters.yaml">
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </xacro:ur_robot>

  <!-- eye in hand: camera rigidly attached to tool0, looking along +z -->
  <link name="camera_link">
    <visual>
      <geometry><box size="0.03 0.06 0.03"/></geometry>
      <material name="cam"><color rgba="0.15 0.15 0.18 1"/></material>
    </visual>
    <collision><geometry><box size="0.03 0.06 0.03"/></geometry></collision>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/>
    </inertial>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="tool0"/>
    <child link="camera_link"/>
    <origin xyz="0 0 0.02" rpy="0 0 0"/>
  </joint>

  <!-- optical frame: computer-vision convention, +z forward, +y down.
       The guard works in normalised image coordinates in THIS frame. -->
  <link name="camera_optical_frame"/>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_frame"/>
    <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
  </joint>

  <ros2_control name="GzSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <xacro:macro name="jnt" params="n init">
      <joint name="${n}">
        <command_interface name="position"/>
        <state_interface name="position"><param name="initial_value">${init}</param></state_interface>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
    </xacro:macro>
    <xacro:jnt n="shoulder_pan_joint"  init="0.0"/>
    <xacro:jnt n="shoulder_lift_joint" init="-1.2"/>
    <xacro:jnt n="elbow_joint"         init="1.4"/>
    <xacro:jnt n="wrist_1_joint"       init="-1.75"/>
    <xacro:jnt n="wrist_2_joint"       init="-1.57"/>
    <xacro:jnt n="wrist_3_joint"       init="0.0"/>
  </ros2_control>

  <gazebo>
    <plugin filename="gz_ros2_control-system"
            name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find blindspot_arm)/config/controllers.yaml</parameters>
    </plugin>
  </gazebo>

  <gazebo reference="camera_link">
    <sensor name="wrist_camera" type="camera">
      <camera>
        <horizontal_fov>1.0472</horizontal_fov>
        <image><width>640</width><height>480</height><format>R8G8B8</format></image>
        <clip><near>0.02</near><far>10.0</far></clip>
        <optical_frame_id>camera_optical_frame</optical_frame_id>
      </camera>
      <always_on>1</always_on>
      <update_rate>20</update_rate>
      <visualize>false</visualize>
      <topic>wrist_camera</topic>
      <gz_frame_id>camera_optical_frame</gz_frame_id>
    </sensor>
  </gazebo>

</robot>
