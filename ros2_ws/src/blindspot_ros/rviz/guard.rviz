Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded: ~
    Tree Height: 400
Visualization Manager:
  Class: ""
  Name: root
  Global Options:
    Background Color: 30; 30; 36
    Fixed Frame: world
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Grid
      Cell Size: 0.02
      Plane Cell Count: 14
      Color: 90; 90; 105
      Line Style:
        Line Width: 0.001
        Value: Lines
      Value: true
    - Class: rviz_default_plugins/TF
      Enabled: true
      Name: TF
      Marker Scale: 0.08
      Show Arrows: false
      Show Axes: true
      Show Names: true
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Target
      Namespaces:
        {}
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /markers
      Value: true
    - Class: rviz_default_plugins/Image
      Enabled: true
      Name: Camera view
      Max Value: 1
      Min Value: 0
      Median window: 5
      Normalize Range: true
      Transport Hint: raw
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /camera/image
      Value: true
  Tools:
    - Class: rviz_default_plugins/MoveCamera
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 0.38
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Pitch: 0.62
      Yaw: 2.35
      Target Frame: world
      Value: Orbit (rviz)
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Camera view:
    collapsed: false
  Height: 1000
  Width: 1760
  Hide Left Dock: false
  Hide Right Dock: false
